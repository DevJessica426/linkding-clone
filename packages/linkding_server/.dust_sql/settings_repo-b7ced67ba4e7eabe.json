      "sql": "\nINSERT INTO bookmarks_globalsettings (landing_page, guest_profile_user_id,\n                                      enable_link_prefetch)\nSELECT 'login', NULL, false\nWHERE NOT EXISTS (SELECT 1 FROM bookmarks_globalsettings)\n",
